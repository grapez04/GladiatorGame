  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ecac2e72a6b5d2d4a91f4cfe94204449, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  upgradeHolder: {fileID: 2305557641756459948}
  entryHolder: {fileID: 1916032845459328579}
  entryPrefab: {fileID: 1495677431577406793, guid: 215d050b3a9c7b74baf9f2676f36fe53, type: 3}
  ageDisplay: {fileID: 2739805018692964847}
  normalColor: {r: 1, g: 1, b: 1, a: 1}
  hoverColor: {r: 1, g: 0, b: 0, a: 1}
  upgradeInfo: {fileID: 4188171479228059574}
  upgradeHowTo: {fileID: 261440889980432103}
  controlText: {fileID: 9022687670648025827}
  speedIcon: {fileID: 21300000, guid: 75ca79520c37d6e409a3e5e4b704f3ec, type: 3}
  healthIcon: {fileID: 21300000, guid: e7d9d2c83ae9c074992f6df41c436166, type: 3}
  damageIcon: {fileID: 21300000, guid: aa367c3977a20fa488e8cdd38c3c244c, type: 3}
  shieldIcon: {fileID: 21300000, guid: 6271caf528d995b4da9406122b4294a9, type: 3}
  speedInfo: Increase your movement speed in battle
  healthInfo: Buy an additional life
  damageInfo: Increase your damage
  shieldInfo: Gain an additional power shield
  shieldHowTo: Use with Right Mouse Button
  crossfade: {fileID: 649977247}
  merchantIntroductionText:
  - Having a hard time sleeping?
  - I know of the hardships your kind has, up there.
  - "Fighting, day after day, drowning ever so in your own sorrow\u2026"
  - "Searching for glory\u2026"
  - "\u2026"
  - Apologies, I should know better than to interrupt your rest.
  - I am a merchant who seeks to help people like you - entertainments for the likes
    of the public.
  - Scurrae that make them clap, laugh, fall all over themselves.
  - Actors who make them feel purified from their guilt by seeing your blood spill
    all over the floor.
  - Over, and over again, with no reward other than being kept alive.
  - However, no human is able to withstand this forever. And I have seen enough of
    you wishing to leave this endless cycle.
  - So, you wish to escape, you must make an upstanding impression on them! Word
    of the coliseum says that a streak of 10 wins will give the public the catharsis
    they seek for and only then, you will be freed.
  - 'But, everybody knows only heroes are capable of feats like this. And I know
    that you are no hero. '
  - 'That is where, my friend, I would be able to assist you. '
  - 'I am giving you the chance to rise up in the arena and earn your freedom. '
  - For the next 10 days, I will be offering you gifts that will be beneficial for
    your performance out there.
  - In exchange, I will ask for years of your lifetime.
  - 'So, the stronger you get, your lifespan will be drained out of you. '
  - Having said this; warrior, do we have a deal?
  defaultUpgradeText: Please pick an upgrade
  musicSource: {fileID: 649977249}
  memoryTheme: {fileID: 8300000, guid: 88521f6eb26318e41aed6e2446c22408, type: 3}
